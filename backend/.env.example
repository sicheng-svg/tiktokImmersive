DOUYIN_ENGLISH_ENVIRONMENT=development
DOUYIN_ENGLISH_AUDIO_DIR=output/audio
DOUYIN_ENGLISH_MEDIA_TEMP_DIR=temp/media
DOUYIN_ENGLISH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOUYIN_ENGLISH_CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
DOUYIN_ENGLISH_TRUSTED_HOSTS=127.0.0.1,localhost
DOUYIN_ENGLISH_ALLOW_MISSING_ORIGIN=true
DOUYIN_ENGLISH_MEDIA_HOST_SUFFIXES=douyin.com,douyinvod.com,bytevcloud.com,bytecdn.cn,zjcdn.com,bytedance.com,bytedance.net,snssdk.com
DOUYIN_ENGLISH_MEDIA_MAX_DOWNLOAD_BYTES=104857600
DOUYIN_ENGLISH_MEDIA_MAX_REDIRECTS=3
DOUYIN_ENGLISH_MEDIA_CONNECT_TIMEOUT_SECONDS=5
DOUYIN_ENGLISH_MEDIA_READ_TIMEOUT_SECONDS=30
DOUYIN_ENGLISH_MEDIA_TOTAL_TIMEOUT_SECONDS=60
DOUYIN_ENGLISH_FFMPEG_BINARY=ffmpeg
DOUYIN_ENGLISH_FFMPEG_TIMEOUT_SECONDS=120
DOUYIN_ENGLISH_MAX_CONCURRENT_JOBS=2
DOUYIN_ENGLISH_MAX_PENDING_JOBS=8
