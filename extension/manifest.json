{
  "manifest_version": 3,
  "name": "Douyin Bilingual Subtitles",
  "description": "为抖音网页版生成与原声同步的中英双语字幕。",
  "version": "0.3.0",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.douyin.com/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Douyin Bilingual Subtitles",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.douyin.com/*"],
      "js": ["media-capture-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.douyin.com/*"],
      "js": ["page-media-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["audio/test.mp3"],
      "matches": ["https://*.douyin.com/*"]
    }
  ]
}
