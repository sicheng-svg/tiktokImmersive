  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@breezystack/lamejs": "^1.2.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
