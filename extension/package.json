{
  "name": "douyin-english-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-test-audio.ps1",
